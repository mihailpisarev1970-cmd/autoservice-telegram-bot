# Скопируйте этот файл в .env и заполните своими значениями.
# Токен бота получите у @BotFather: https://t.me/BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Шлюз Polza.ai (OpenAI-совместимый API): https://polza.ai/
POLZA_API_KEY=your_polza_api_key_here
POLZA_BASE_URL=https://api.polza.ai/v1
AI_MODEL=openai/gpt-4o-mini

# Redis (FSM-хранилище состояний)
REDIS_HOST=redis
REDIS_PORT=6379

# Baserow CRM
BASEROW_URL=https://your-baserow-instance.com
BASEROW_TOKEN=your_baserow_token_here
BASEROW_TABLE_ID=278
